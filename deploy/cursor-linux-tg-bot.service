[Unit]
Description=Telegram/VK bridge to Cursor local agent (Linux)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install.sh подставит REPO_DIR, SERVICE_USER и пути
WorkingDirectory=/root/CursorLinuxTgBot
EnvironmentFile=/root/CursorLinuxTgBot/.env
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/CursorLinuxTgBot/.venv/bin/python /root/CursorLinuxTgBot/run.py -c /root/CursorLinuxTgBot/config.yaml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cursor-linux-tg-bot

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
