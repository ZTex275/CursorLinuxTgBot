{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Bot (F5)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["${workspaceFolder}/.vscode/run-bot.sh"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Bot (Python)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "python": "/opt/cursor-linux-tg-bot/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "args": ["-c", "config.yaml", "-v"],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PATH": "${env:HOME}/.local/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug Bot (debugpy)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "python": "/opt/cursor-linux-tg-bot/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "args": ["-c", "config.yaml", "-v"],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PATH": "${env:HOME}/.local/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
